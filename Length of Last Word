import java.util.*;
public class Main {
    public static void main(String[] args) {
        String s = "Hello World";

        s = s.trim();
        int count = 0;

        for (int i = s.length() - 1; i >= 0; i--) {
            if (s.charAt(i) == ' ') {
                break;
            }
            count++;
        }

        System.out.println("Length of last word: " + count);
    }
}
